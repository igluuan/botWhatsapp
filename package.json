{
  "name": "bot-whatsapp",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp Financial Companion Bot foundation",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
